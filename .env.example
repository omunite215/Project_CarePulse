# =============================================================================
# CarePulse environment
#
# Everything here is OPTIONAL. With no .env.local at all the app boots in demo
# mode against seeded in-memory fixtures — which is how the screenshots and the
# end-to-end tests run. Copy this file to .env.local only when you want to point
# it at a real backend.
#
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Appwrite (live mode)
#
# Set ALL of these together or none of them. A partial configuration is treated
# as a mistake and fails at boot rather than silently falling back to fixtures.
#
# Requires an Appwrite server on 1.9.x — node-appwrite 28 targets that API.
# Older instances (1.5.x and friends) will 404 on the newer endpoints.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENDPOINT=https://cloud.appwrite.io/v1
# PROJECT_ID=
# API_KEY=
# DATABASE_ID=
# PATIENT_COLLECTION_ID=
# APPOINTMENT_COLLECTION_ID=
# NEXT_PUBLIC_BUCKET_ID=

# -----------------------------------------------------------------------------
# Admin access
#
# Note there is no NEXT_PUBLIC_ prefix. The passkey is compared server-side with
# a timing-safe comparison and exchanged for a signed httpOnly cookie, so it is
# never shipped to the browser.
# -----------------------------------------------------------------------------
# ADMIN_PASSKEY=123456

# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Demo mode
# -----------------------------------------------------------------------------
# Force fixtures even when Appwrite credentials are present.
# DEMO_MODE=true

# Fixture seed. Keep it fixed so screenshots and E2E assertions stay stable.
# DEMO_SEED=42

# Simulated read latency in milliseconds, so the loading skeletons are actually
# reachable instead of theoretical — fixtures resolve in ~0ms otherwise. Reads
# only; booking and the admin actions stay instant. Set to 0 to turn it off.
# Ignored entirely in live mode.
# DEMO_LATENCY_MS=600
